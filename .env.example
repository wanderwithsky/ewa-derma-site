# Ewa Derma Clinic - Environment Variables Example

# Resend API Key for Email Notifications (Patient Booking Confirmations & Clinic Lead Alerts)
# Get your key at https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Clinic Reception / Notification Email
CLINIC_NOTIFICATION_EMAIL=care@ewaderma.com

# Base URL of the Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
